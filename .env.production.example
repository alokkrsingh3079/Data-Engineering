NODE_ENV=production
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/sql_software?retryWrites=true&w=majority
MONGODB_DATABASE=sql_software
DATABASE_URL=postgresql://<postgres-user>:<password>@<postgres-host>:5432/<database>
PRACTICE_DATABASE_URL=postgresql://<postgres-user>:<password>@<postgres-host>:5432/<database>
AUTH_SECRET=<generate-a-unique-random-secret-at-least-32-characters>
PRACTICE_ROLE_SECRET=<generate-a-separate-stable-random-secret>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<unique-password-for-the-first-admin>
ALLOWED_ORIGIN=https://<your-cloudflare-worker-hostname>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
